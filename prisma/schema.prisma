generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSession {
  id              String   @id @default(cuid())
  discordUserId    String   @unique
  accessToken      String
  postizUserId     String?
  stripeCustomerId String?
  authenticatedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_sessions")
}

model BillingAction {
  id              String   @id @default(cuid())
  discordUserId   String
  stripeInvoiceId String   @unique
  action          String   // "refund" or "discount"
  createdAt       DateTime @default(now())

  @@map("billing_actions")
}

// A self-service refund blocked by a guardrail, awaiting staff /charge approve|deny.
model PendingChargeReview {
  id             String    @id @default(cuid())
  threadId       String    @unique
  chargeId       String
  subscriptionId String?
  customerId     String
  amount         Int
  currency       String
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | DENIED | ALREADY_PROCESSED
  reviewerId     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@map("pending_charge_reviews")
}

model PendingAuth {
  id               String   @id @default(cuid())
  state            String   @unique
  discordUserId    String
  channelId        String
  interactionToken String?
  createdAt        DateTime @default(now())

  @@map("pending_auths")
}

model BotSettings {
  id                  String    @id @default("global")
  threadsChannelId    String?
  supportRoleId       String?
  githubRepo          String?
  aiSolveEnabled      Boolean   @default(true)
  backfillDone        Boolean   @default(false)
  reportChannelId     String?
  reportEnabled       Boolean   @default(false)
  reportIntervalHours Int       @default(24)
  reportHour          Int?
  reportMinute        Int?
  reportTimezone      String    @default("UTC")
  reportLastRunAt     DateTime?
  reportLastSnapshot  Json?
  overdueThresholdDays Int      @default(7)
  maxOpenTicketsPerUser Int     @default(3)
  ticketCooldownMinutes Int     @default(5)
  billingAuditChannelId String?
  refundMaxAmount     Int?
  refundMaxAmountCurrency String @default("usd")
  refundMaxPer24h     Int?
  refundMinMemberAgeDays Int?
  auditLogChannelId   String?
  // Chatwoot bridge (all edited via /config → Chatwoot, no env access on deploy).
  // Auth model: NO agent API key — the contact side uses the public Client API
  // (inbox identifier + identity-validation HMAC), the agent side an Agent Bot token.
  chatwootMode        String    @default("none") // "none" | "push" | "bi"
  chatwootBaseUrl     String?
  chatwootAccountId   String?
  chatwootInboxIdentifier String?
  chatwootHmacKey     String?
  chatwootBotToken    String?
  chatwootWebhookSecret String?
  updatedAt           DateTime  @updatedAt

  @@map("bot_settings")
}

// One row per Discord ticket bridged to a Chatwoot conversation.
// conversationId is Chatwoot's display_id (used by bot endpoints and webhooks);
// contactSourceId is the Client-API contact identifier (source_id) needed to
// post customer messages as the contact.
model ChatwootLink {
  id               String    @id @default(cuid())
  ticketThreadId   String    @unique
  contactId        Int
  contactSourceId  String
  conversationId   Int       @unique
  // Push mode: stamped when the one-time "one-way mirror" warning note was sent.
  agentWarnedAt    DateTime?
  // Last open/resolved state the bridge pushed — damps status echo loops.
  lastSyncedStatus String?
  createdAt        DateTime  @default(now())

  @@map("chatwoot_links")
}

// Durable queue of pending Chatwoot API calls. Global seq gives per-ticket FIFO;
// the drainer only processes the head event per ticketThreadId.
model ChatwootOutboxEvent {
  id             String   @id @default(cuid())
  seq            Int      @unique @default(autoincrement())
  ticketThreadId String
  type           String   // ensure_conversation | message | note | status | priority | csat
  payload        Json
  status         String   @default("PENDING") // PENDING | DEAD
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, seq])
  @@index([status, nextAttemptAt])
  @@map("chatwoot_outbox")
}

model StatusTag {
  id              String   @id @default(cuid())
  emoji           String   @unique
  label           String
  isInitial       Boolean  @default(false)
  closesThread    Boolean  @default(false)
  reminderEnabled Boolean  @default(false)
  reminderDays    Int      @default(3)
  reminderTarget  String   @default("SUPPORT")
  autoCloseAfter  Int?
  sortOrder       Int      @default(0)
  tickets         Ticket[]

  @@map("status_tags")
}

model PriorityTag {
  id        String   @id @default(cuid())
  emoji     String   @unique
  label     String
  isInitial Boolean  @default(false)
  sortOrder Int      @default(0)
  tickets   Ticket[]

  @@map("priority_tags")
}

model Ticket {
  id                  String     @id @default(cuid())
  threadId            String     @unique
  channelId           String
  customerId          String?
  customerDisplayName String?
  categoryId          String?
  statusTagId         String?
  statusTag           StatusTag? @relation(fields: [statusTagId], references: [id])
  // Status the ticket had before the last status change (plain id, no FK — resolved via
  // the SettingsStore cache). Used to restore a "Waiting for Customer" ticket when the
  // customer replies.
  prevStatusTagId     String?
  priorityTagId       String?
  priorityTag         PriorityTag? @relation(fields: [priorityTagId], references: [id])
  escalationTierId    String?
  escalationTier      EscalationTier? @relation(fields: [escalationTierId], references: [id])
  lastStatusChangeAt  DateTime   @default(now())
  lastReminderAt      DateTime?
  reminderCount       Int        @default(0)
  closed              Boolean    @default(false)
  closedAt            DateTime?
  // When set, the re-close scheduler locks/archives the thread again at this time.
  // Stamped (last message + 30m) whenever someone writes in an already-closed ticket.
  recloseAt           DateTime?
  question            String?
  firstResponseAt     DateTime?
  csatScore           Int?
  csatComment         String?
  csatPromptedAt      DateTime?
  csatRatedAt         DateTime?
  createdAt           DateTime   @default(now())

  @@map("tickets")
}

model TicketNote {
  id             String   @id @default(cuid())
  ticketThreadId String
  authorId       String
  authorName     String
  text           String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId])
  @@map("ticket_notes")
}

// Append-only status/priority change history. Emoji+label are snapshotted as text
// so history survives tag edits and deletions.
model TicketTagChange {
  id             String   @id @default(cuid())
  ticketThreadId String
  kind           String   // "STATUS" | "PRIORITY"
  fromEmoji      String?
  fromLabel      String?
  toEmoji        String
  toLabel        String
  actorId        String?
  actorName      String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, kind])
  @@map("ticket_tag_changes")
}

// Ordered staff ladder (position 0 = lowest tier). Tier 0 gets new-ticket pings
// and its members are added to ticket threads; membership in any tier role counts
// as staff. Replaces the legacy single BotSettings.supportRoleId.
model EscalationTier {
  id        String   @id @default(cuid())
  name      String
  roleId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@map("escalation_tiers")
}

model CannedResponse {
  id        String   @id @default(cuid())
  name      String
  content   String
  // Discord user id when the response is personal; null means the whole team can use it.
  ownerId   String?
  createdAt DateTime @default(now())

  @@unique([name, ownerId])
  @@map("canned_responses")
}
