generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSession {
  id              String   @id @default(cuid())
  discordUserId    String   @unique
  accessToken      String
  postizUserId     String?
  stripeCustomerId String?
  authenticatedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_sessions")
}

model BillingAction {
  id              String   @id @default(cuid())
  discordUserId   String
  stripeInvoiceId String   @unique
  action          String   // "refund" or "discount"
  createdAt       DateTime @default(now())

  @@map("billing_actions")
}

// A self-service refund blocked by a guardrail, awaiting staff /charge approve|deny.
model PendingChargeReview {
  id             String    @id @default(cuid())
  threadId       String    @unique
  chargeId       String
  subscriptionId String?
  customerId     String
  amount         Int
  currency       String
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | DENIED | ALREADY_PROCESSED
  reviewerId     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@map("pending_charge_reviews")
}

model PendingAuth {
  id               String   @id @default(cuid())
  state            String   @unique
  discordUserId    String
  channelId        String
  interactionToken String?
  createdAt        DateTime @default(now())

  @@map("pending_auths")
}

model BotSettings {
  id                  String    @id @default("global")
  threadsChannelId    String?
  supportRoleId       String?
  githubRepo          String?
  aiSolveEnabled      Boolean   @default(true)
  aiCommandsEnabled   Boolean   @default(true)
  backfillDone        Boolean   @default(false)
  reportChannelId     String?
  reportEnabled       Boolean   @default(false)
  reportIntervalHours Int       @default(24)
  reportHour          Int?
  reportMinute        Int?
  reportTimezone      String    @default("UTC")
  reportLastRunAt     DateTime?
  reportLastSnapshot  Json?
  overdueThresholdDays Int      @default(7)
  maxOpenTicketsPerUser Int     @default(3)
  ticketCooldownMinutes Int     @default(5)
  billingAuditChannelId String?
  refundMaxAmount     Int?
  refundMaxAmountCurrency String @default("usd")
  refundMaxPer24h     Int?
  refundMinMemberAgeDays Int?
  // /billing plan allowlist: comma-separated Stripe price ids. Empty = all
  // active recurring prices are offered in the create/change-plan pickers.
  allowedPriceIds     String    @default("")
  auditLogChannelId   String?
  // Intercom bridge (all edited via /config → Intercom; deploy has no .env access).
  intercomMode          String  @default("none") // "none" | "push" | "bi"
  intercomRegion        String  @default("us")   // "us" | "eu" | "au"
  intercomAccessToken   String?
  intercomClientSecret  String?                  // app client secret — webhook HMAC
  intercomAdminId       String?                  // configured authoring admin (fallback)
  intercomOperatorAdminId String?                // auto-detected Operator/Fin; null = rejected/not found
  intercomTicketTypeMap Json?                    // { "<categoryId>"|"_default": "<ticketTypeId>" }
  intercomTeamId        String?                  // team the bridge assigns new conversations/tickets to (null = unassigned)
  // Status tag applied in Discord when an agent snoozes the conversation in Intercom.
  intercomSnoozeStatusTagId String?
  // Sentry DSN (set via /config; deploy has no .env access). Null = Sentry disabled.
  sentryDsn             String?
  // Sentry observability knobs (all edited via /config → Sentry).
  sentryEnvironment        String  @default("production")
  sentryTracesSampleRate   Float   @default(1.0)
  sentryProfilesSampleRate Float   @default(1.0)  // needs the optional native @sentry/profiling-node addon
  sentryLogsEnabled        Boolean @default(true) // Sentry Logs product + console.* capture
  sentryDebug              Boolean @default(false) // SDK debug to stdout; restart to apply
  sentrySendDefaultPii     Boolean @default(false)
  sentryAiRecordContent    Boolean @default(true) // AI prompts/responses/tool I/O on gen_ai spans
  // Sentry READ access — separate from the write-only DSN above. Lets /ai correlate
  // a ticket with real Postiz product errors. Token is encrypted at rest (crypto.ts);
  // needs an auth token (event:read, project:read) + org/project slugs. Off by default.
  sentryReadEnabled        Boolean @default(false)
  sentryReadToken          String?
  sentryOrgSlug            String?
  sentryProjectSlug        String?
  sentryReadRegion         String  @default("us") // "us" | "eu" — org tokens don't auto-route to EU (de.sentry.io)
  // AI models (edited via /config → AI & Knowledge). Free-text so new model ids
  // work without a code change. Light model runs the tool-less /ai summarize|draft.
  aiModel               String  @default("sonnet")
  aiModelLight          String  @default("haiku")
  // /ai ask|cause bounding levers (CLI 2.1.81 has no --max-turns). Effort is
  // low|medium|high|max; budget is a hard per-run USD cap. Edited via /config → AI.
  aiEffortAsk           String  @default("medium")
  aiEffortCause         String  @default("high")
  aiMaxBudgetUsdAsk     Float   @default(1.0)
  aiMaxBudgetUsdCause   Float   @default(3.0)
  // Pre-fetch the ticket customer's live Postiz account (channels + recent posts)
  // into the /ai ask|cause context. Kill-switch for prod (no .env on deploy).
  aiPostizPrefetchEnabled Boolean @default(true)
  // Knowledge-base auto-refresh: git pull the cloned Postiz source/docs on a timer.
  kbRefreshEnabled       Boolean   @default(true)
  kbRefreshIntervalHours Int       @default(6)
  kbLastRefreshAt        DateTime?
  // Per-user self-service refund velocity cap (the existing refundMaxPer24h is global).
  refundMaxPer24hPerUser Int?
  // Stripe webhook ingestion (disputes + early-fraud alerts). The endpoint is
  // registered programmatically; the signing secret is stored encrypted at rest.
  stripeWebhookEnabled    Boolean @default(false)
  stripeWebhookEndpointId String?
  stripeWebhookSecret     String? // whsec_… — encrypted (see src/util/crypto.ts)
  // Bot's public origin for programmatic webhook registration; falls back to
  // new URL(POSTIZ_CALLBACK_URL).origin when unset.
  publicBaseUrl           String?
  updatedAt           DateTime  @updatedAt

  @@map("bot_settings")
}

model StatusTag {
  id              String   @id @default(cuid())
  emoji           String   @unique
  label           String
  isInitial       Boolean  @default(false)
  closesThread    Boolean  @default(false)
  reminderEnabled Boolean  @default(false)
  reminderDays    Int      @default(3)
  reminderTarget  String   @default("SUPPORT")
  autoCloseAfter  Int?
  sortOrder       Int      @default(0)
  // When a customer replies to a Waiting-for-Customer ticket, it moves to the tag
  // flagged here (at most one) instead of reverting to its previous status. Unset
  // on every tag → fall back to the previous-status behaviour.
  isCustomerReplyTarget Boolean @default(false)
  // Intercom ticket state this tag maps to (set via /config → Intercom → States).
  intercomTicketStateId String?
  tickets         Ticket[]

  @@map("status_tags")
}

model PriorityTag {
  id        String   @id @default(cuid())
  emoji     String   @unique
  label     String
  isInitial Boolean  @default(false)
  sortOrder Int      @default(0)
  tickets   Ticket[]

  @@map("priority_tags")
}

model Ticket {
  id                  String     @id @default(cuid())
  threadId            String     @unique
  channelId           String
  customerId          String?
  customerDisplayName String?
  categoryId          String?
  statusTagId         String?
  statusTag           StatusTag? @relation(fields: [statusTagId], references: [id])
  // Status the ticket had before the last status change (plain id, no FK — resolved via
  // the SettingsStore cache). Used to restore a "Waiting for Customer" ticket when the
  // customer replies.
  prevStatusTagId     String?
  priorityTagId       String?
  priorityTag         PriorityTag? @relation(fields: [priorityTagId], references: [id])
  escalationTierId    String?
  escalationTier      EscalationTier? @relation(fields: [escalationTierId], references: [id])
  lastStatusChangeAt  DateTime   @default(now())
  lastReminderAt      DateTime?
  reminderCount       Int        @default(0)
  // Set by /reminders off: suppresses reminders, auto-close and re-close for this
  // ticket. Cleared automatically on every status change.
  remindersPaused     Boolean    @default(false)
  closed              Boolean    @default(false)
  closedAt            DateTime?
  // When set, the re-close scheduler locks/archives the thread again at this time.
  // Stamped (last message + 30m) whenever someone writes in an already-closed ticket.
  recloseAt           DateTime?
  question            String?
  // Verbatim final AI answer, persisted so a filed GitHub issue is just question +
  // answer (not a brittle re-scan of the last few thread messages).
  aiAnswer            String?
  firstResponseAt     DateTime?
  csatScore           Int?
  csatComment         String?
  csatPromptedAt      DateTime?
  csatRatedAt         DateTime?
  createdAt           DateTime   @default(now())

  @@map("tickets")
}

model TicketNote {
  id             String   @id @default(cuid())
  ticketThreadId String
  authorId       String
  authorName     String
  text           String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId])
  @@map("ticket_notes")
}

// Append-only status/priority change history. Emoji+label are snapshotted as text
// so history survives tag edits and deletions.
model TicketTagChange {
  id             String   @id @default(cuid())
  ticketThreadId String
  kind           String   // "STATUS" | "PRIORITY"
  fromEmoji      String?
  fromLabel      String?
  toEmoji        String
  toLabel        String
  actorId        String?
  actorName      String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, kind])
  @@map("ticket_tag_changes")
}

// Ordered staff ladder (position 0 = lowest tier). Tier 0 gets new-ticket pings
// and its members are added to ticket threads; membership in any tier role counts
// as staff. Replaces the legacy single BotSettings.supportRoleId.
model EscalationTier {
  id        String   @id @default(cuid())
  name      String
  roleId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@map("escalation_tiers")
}

model CannedResponse {
  id        String   @id @default(cuid())
  name      String
  content   String
  // Discord user id when the response is personal; null means the whole team can use it.
  ownerId   String?
  createdAt DateTime @default(now())

  @@unique([name, ownerId])
  @@map("canned_responses")
}

// Discord ticket ↔ Intercom conversation + converted customer ticket. ticketId is
// null between conversation creation and a successful convert, which makes the
// ensure job crash-resumable.
model IntercomLink {
  id                String    @id @default(cuid())
  ticketThreadId    String    @unique
  contactId         String // Intercom contact id
  contactExternalId String // external_id we registered (postizUserId / discord:{id})
  conversationId    String    @unique
  ticketId          String?   @unique // Intercom ticket API id (NOT the human ticket_id)
  agentWarnedAt     DateTime? // push mode: one-time "replies don't reach the customer" note
  lastSyncedStateId String? // last ticket_state_id the bridge pushed (echo damper)
  lastSyncedOpen    String? // "open" | "closed" — conversation open/close parity damper
  // Last-seen Intercom tag name set (JSON string[]) — inbound tag-diff damper.
  lastTagsJson      Json?
  createdAt         DateTime  @default(now())

  @@map("intercom_links")
}

model IntercomOutboxEvent {
  id             String   @id @default(cuid())
  // Global monotonic sequence; per-ticket FIFO comes from draining only the
  // lowest-seq PENDING event per ticket.
  seq            Int      @unique @default(autoincrement())
  ticketThreadId String
  type           String // ensure | message | note | status | priority | csat
  payload        Json
  status         String   @default("PENDING") // PENDING | DEAD
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, seq])
  @@index([status, nextAttemptAt])
  @@map("intercom_outbox")
}

// Part-id ledger for echo suppression (Intercom has no writable content stamp).
// The outbox records every conversation/ticket part the bridge creates; the
// webhook handler atomically claims each part it sees — a conflict means it's
// either the bridge's own echo or a duplicate delivery, and gets dropped.
model IntercomEchoPart {
  id             String   @id @default(cuid())
  kind           String // "c" = conversation part, "t" = ticket part, "r" = relay body-hash dedup
  partId         String
  ticketThreadId String
  createdAt      DateTime @default(now())

  @@unique([kind, partId])
  @@index([createdAt])
  @@map("intercom_echo_parts")
}

// Durable inbound webhook queue: the HTTP route only inserts a row and 200s;
// IntercomInboxScheduler processes rows in seq order with retry/dead-letter.
// deliveryId dedupes Intercom's single redelivery attempt.
model IntercomInboxEvent {
  id            String   @id @default(cuid())
  seq           Int      @unique @default(autoincrement())
  deliveryId    String?  @unique
  topic         String
  payload       Json
  status        String   @default("PENDING") // PENDING | DEAD
  attempts      Int      @default(0) // real processing failures (dead-letters at MAX_ATTEMPTS)
  deferAttempts Int      @default(0) // echo-suppression defers (bounded by MAX_DEFER_ATTEMPTS); kept separate so heavy deferral doesn't burn the retry budget
  nextAttemptAt DateTime @default(now())
  lastError     String?
  receivedAt    DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@map("intercom_inbox")
}

// Dedup ledger for incoming Stripe webhook events (Stripe redelivers on non-2xx
// and occasionally at-least-once). The event id is globally unique, so it is the
// primary key — an insert conflict means "already handled → drop".
model StripeWebhookEvent {
  id        String   @id // Stripe event id (evt_…)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("stripe_webhook_events")
}

// Reserve→call→confirm echo records: the outbox writes a row (normalized body
// hash) BEFORE posting to Intercom and deletes it after recording the created
// part id in the echo ledger. The webhook handler treats a matching row as
// "this part is our own in-flight post" — replaces the old fixed-sleep race.
model IntercomPendingPost {
  id             String   @id @default(cuid())
  ticketThreadId String
  kind           String // "c" | "t"
  bodyHash       String // sha256 of whitespace-collapsed plain text of the sent body
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, bodyHash])
  @@map("intercom_pending_posts")
}
