generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSession {
  id              String   @id @default(cuid())
  discordUserId    String   @unique
  accessToken      String
  postizUserId     String?
  stripeCustomerId String?
  authenticatedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_sessions")
}

model BillingAction {
  id              String   @id @default(cuid())
  discordUserId   String
  stripeInvoiceId String   @unique
  action          String   // "refund" or "discount"
  createdAt       DateTime @default(now())

  @@map("billing_actions")
}

// A self-service refund blocked by a guardrail, awaiting staff /charge approve|deny.
model PendingChargeReview {
  id             String    @id @default(cuid())
  threadId       String    @unique
  chargeId       String
  subscriptionId String?
  customerId     String
  amount         Int
  currency       String
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | DENIED | ALREADY_PROCESSED
  reviewerId     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@map("pending_charge_reviews")
}

// Queued billing action from the Intercom canvas/panel awaiting admin approval.
// actionKey references the ActionRegistry; params are the validated snapshot
// taken at queue time (revalidated against live Stripe state at execute time).
model BillingApproval {
  id               String    @id @default(cuid())
  actionKey        String
  paramsJson       Json
  summary          String // human-readable summary rendered at queue time
  conversationId   String? // Intercom conversation the request came from (null for dashboard-origin)
  origin           String    @default("intercom") // "intercom" | "dashboard" — decides ctx rebuild at approval time
  ticketThreadId   String?
  stripeCustomerId String?
  requestedById    String // Intercom teammate id (or Discord id for dashboard-origin)
  requestedByName  String
  status           String    @default("PENDING") // PENDING | EXECUTING | EXECUTED | REJECTED | EXPIRED | FAILED
  reviewerId       String? // "intercom:<id>" or "discord:<id>"
  reviewerName     String?
  claimedAt        DateTime? // last claimForExecution stamp — stale-EXECUTING reclaim window
  resultText       String?
  errorText        String?
  expiresAt        DateTime // createdAt + 7 days; lazily flipped to EXPIRED
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([conversationId, status])
  @@map("billing_approvals")
}

model PendingAuth {
  id               String   @id @default(cuid())
  state            String   @unique
  discordUserId    String
  channelId        String
  interactionToken String?
  createdAt        DateTime @default(now())

  @@map("pending_auths")
}

model BotSettings {
  id                  String    @id @default("global")
  threadsChannelId    String?
  supportRoleId       String?
  githubRepo          String?
  aiSolveEnabled      Boolean   @default(true)
  aiCommandsEnabled   Boolean   @default(true)
  backfillDone        Boolean   @default(false)
  reportChannelId     String?
  reportEnabled       Boolean   @default(false)
  reportIntervalHours Int       @default(24)
  reportHour          Int?
  reportMinute        Int?
  reportTimezone      String    @default("UTC")
  reportLastRunAt     DateTime?
  reportLastSnapshot  Json?
  overdueThresholdDays Int      @default(7)
  maxOpenTicketsPerUser Int     @default(3)
  ticketCooldownMinutes Int     @default(5)
  billingAuditChannelId String?
  refundMaxAmount     Int?
  refundMaxAmountCurrency String @default("usd")
  refundMaxPer24h     Int?
  refundMinMemberAgeDays Int?
  // /billing plan allowlist: comma-separated Stripe price ids. Empty = all
  // active recurring prices are offered in the create/change-plan pickers.
  allowedPriceIds     String    @default("")
  auditLogChannelId   String?
  // Intercom bridge (all edited via /config → Intercom; deploy has no .env access).
  intercomMode          String  @default("none") // "none" | "push" | "bi"
  intercomRegion        String  @default("us")   // "us" | "eu" | "au"
  intercomAccessToken   String?
  intercomClientSecret  String?                  // app client secret — webhook HMAC
  intercomAdminId       String?                  // configured authoring admin (fallback)
  intercomOperatorAdminId String?                // auto-detected Operator/Fin; null = rejected/not found
  intercomTicketTypeMap Json?                    // { "<categoryId>"|"_default": "<ticketTypeId>" }
  intercomTeamId        String?                  // team the bridge assigns new conversations/tickets to (null = unassigned)
  // Status tag applied in Discord when an agent snoozes the conversation in Intercom.
  intercomSnoozeStatusTagId String?
  intercomLastInboundAt DateTime? // last verified inbound webhook — /config health line
  intercomModeChangedAt DateTime? // last mode flip — none→bi gap heal reads parts newer than this
  // Workspace inactivity sweeper (native/unbridged conversations + tickets):
  // the bot runs the reminder/auto-close automation Intercom can't apply to
  // API-created conversations. Ships OFF; edited via /config → Intercom →
  // Inactivity. Bridged tickets are excluded (per-ticket timers own them).
  inactivityEnabled          Boolean @default(false)
  inactivityAgentWaitDays    Int     @default(2) // customer spoke last, no agent reply for N days → note + reopen
  inactivityCustomerWaitDays Int     @default(3) // agent spoke last, customer silent N days → outbound nag
  inactivityNagsBeforeClose  Int     @default(2) // unanswered customer nags before the sweeper closes
  inactivityNagText          String? // sweeper customer nag override ({days} supported); null = built-in default
  inactivityAgentNoteText    String? // sweeper agent-idle note override ({days} supported); null = built-in default
  // One-time agent-rip migration stamp (resolved-tag flip + thread sweeps) —
  // temporalImportDoneAt precedent: machinery removed later, column stays.
  agentRipMigratedAt DateTime?
  // Sentry DSN (set via /config; deploy has no .env access). Null = Sentry disabled.
  sentryDsn             String?
  // Sentry observability knobs (all edited via /config → Sentry).
  sentryEnvironment        String  @default("production")
  sentryTracesSampleRate   Float   @default(1.0)
  sentryProfilesSampleRate Float   @default(1.0)  // needs the optional native @sentry/profiling-node addon
  sentryLogsEnabled        Boolean @default(true) // Sentry Logs product + console.* capture
  sentryDebug              Boolean @default(false) // SDK debug to stdout; restart to apply
  sentrySendDefaultPii     Boolean @default(false)
  sentryAiRecordContent    Boolean @default(false) // AI prompts/responses/tool I/O on gen_ai spans — off by default (customer PII); opt in via /config
  // Sentry READ access — separate from the write-only DSN above. Feeds the
  // feedback import (Sentry User Feedback widget → Intercom conversations).
  // Token is encrypted at rest (crypto.ts/Vault); needs an org auth token
  // (org:read, project:read, event:read). Off by default.
  sentryReadEnabled        Boolean @default(false)
  sentryReadToken          String?
  sentryOrgSlug            String?
  sentryProjectSlug        String? // comma-separated project slugs to import from; null/empty = all projects
  sentryReadRegion         String  @default("us") // "us" | "eu" — org tokens don't auto-route to EU (de.sentry.io)
  // Sentry feedback → Intercom import (edited via /config → Integrations → Sentry Feedback).
  sentryFeedbackTeamId       String?   // Intercom team imported conversations are assigned to; null = unassigned
  sentryFeedbackWatermarkAt  DateTime? // stamped at FIRST enable; only feedback newer than this ever imports (no backfill)
  sentryFeedbackLastSyncAt   DateTime? // last completed sync tick — /config status line
  sentryWebhookSecret        String?   // Sentry internal-integration client secret — encrypted (crypto.ts/Vault)
  sentryFeedbackTicketTypeId String?   // convert imports into customer tickets of this type; null = plain conversations
  // Postiz platform lookup (GET /public/v1/users?name= — superadmin search).
  // The key's org must contain a superadmin user AND hold a subscription, or
  // every call 401s. POSTIZ_ADMIN_TOKEN in the environment overrides the
  // column (see config/env.ts); the column is encrypted (crypto.ts/Vault).
  postizLookupEnabled Boolean @default(false)
  postizBaseUrl       String? // backend origin the /public/v1 routes hang off, no trailing slash
  postizApiKey        String?
  // Forwarded-email conversion (lite-seat teammate forwards a customer email to
  // support@ → recreate the conversation for the original sender; edited via
  // /intercom → Automation). Replicates Intercom's "Detect customers in
  // forwarded emails", which does not run for lite-seat forwarders.
  forwardConvertEnabled     Boolean @default(false)
  forwardConvertTagName     String  @default("email") // tag applied to the recreated conversation
  forwardConvertCloseNote   String? // close-note override on the misattributed original ({email} supported); null = built-in default
  forwardConvertExtraEmails String  @default("") // comma-separated forwarder addresses treated like lite-seat teammates (personal mailboxes etc.)
  // AI models (edited via /config → AI & Knowledge). Free-text so new model ids
  // work without a code change. Light model runs the tool-less /ai summarize|draft.
  aiModel               String  @default("sonnet")
  aiModelLight          String  @default("haiku")
  // /ai ask|cause bounding levers (CLI 2.1.81 has no --max-turns). Effort is
  // low|medium|high|max; budget is a hard per-run USD cap. Edited via /config → AI.
  aiEffortAsk           String  @default("medium")
  aiEffortCause         String  @default("high")
  aiMaxBudgetUsdAsk     Float   @default(1.0)
  aiMaxBudgetUsdCause   Float   @default(3.0)
  // Pre-fetch the ticket customer's live Postiz account (channels + recent posts)
  // into the /ai ask|cause context. Kill-switch for prod (no .env on deploy).
  aiPostizPrefetchEnabled Boolean @default(true)
  // Feed earlier /ai run results on the same ticket back into new /ai runs.
  aiPreviousRunsEnabled Boolean @default(true)
  // Knowledge-base auto-refresh: git pull the cloned Postiz source/docs on a timer.
  kbRefreshEnabled       Boolean   @default(true)
  kbRefreshIntervalHours Int       @default(6)
  kbLastRefreshAt        DateTime?
  // Per-user self-service refund velocity cap (the existing refundMaxPer24h is global).
  refundMaxPer24hPerUser Int?
  // Self-service refunds only for charges younger than N days (null = off).
  // getLastSubscriptionCharge already prefilters to 35 days, so values >35
  // never trip in practice.
  refundMaxChargeAgeDays Int? @default(31)
  // Stripe webhook ingestion (disputes + early-fraud alerts). The endpoint is
  // registered programmatically; the signing secret is stored encrypted at rest.
  stripeWebhookEnabled    Boolean @default(false)
  stripeWebhookEndpointId String?
  stripeWebhookSecret     String? // whsec_… — encrypted (see src/util/crypto.ts)
  // Stripe account API key (sk_…): managed copy of the STRIPE_SECRET_KEY env
  // var (auto-seeded on boot, rotatable at runtime). The env var itself never
  // goes away — it feeds the crypto.ts key derivation and is the read fallback.
  stripeSecretKey         String?
  // Bot's public origin for programmatic webhook registration; falls back to
  // new URL(POSTIZ_CALLBACK_URL).origin when unset.
  publicBaseUrl           String?
  // Dispute management (paired with /config → Billing → Disputes). Auto-action
  // toggles ship OFF so deploys are inert until an admin enables them. The
  // Radar value-list ids are provisioned once via the panel; the lists only
  // act when a Dashboard rule references them (Radar for Fraud Teams).
  disputeAutoCancelSub    Boolean @default(false)
  disputeAutoBlock        Boolean @default(false)
  // Exception to ships-OFF: staging a receipt file (submit:false) moves no
  // money and sends nothing to the bank, so this one defaults ON.
  disputeAutoAttachReceipt Boolean @default(true)
  disputeReminderDays     Int     @default(3)
  disputeRatioWarnPct     Float   @default(0.5)
  disputeRatioCriticalPct Float   @default(0.9)
  disputeRatioLastLevel   String  @default("ok") // ok | warn | critical — alert-on-transition state
  // Urgent reminder tier: respondable + unsubmitted + due within this many
  // hours escalates the reminder (red embed + role mention). Role unset =
  // urgent styling without a mention, so the deploy ships inert.
  disputeUrgentHours      Int     @default(48)
  disputeUrgentRoleId     String?
  disputeBackfillDoneAt   DateTime? // last all-time dispute history backfill run
  radarListCardId         String?
  radarListEmailId        String?
  radarListCustomerId     String?
  radarListIpId           String?
  // InfluxDB 2.x metrics export (edited via /config → Analytics; no .env on deploy).
  // Token is encrypted at rest (crypto.ts). Exporter is inactive until all four
  // connection fields are set AND influxEnabled is true.
  influxEnabled           Boolean @default(false)
  influxUrl               String?
  influxOrg               String?
  influxBucket            String?
  influxToken             String?
  // AI ticket scoring (Batch API, cheap model). Interval default 6h = 4 batches/day;
  // the Batch discount is identical at any cadence, so this is purely freshness.
  scoringEnabled            Boolean   @default(false)
  scoringIntervalHours      Int       @default(6)
  scoringModel              String    @default("claude-haiku-4-5")
  scoringMaxTicketsPerBatch Int       @default(200)
  scoringMaxBudgetUsdPerDay Float     @default(5.0)
  scoringLastRunAt          DateTime?
  // One-time historical backfill flag: while true the scheduler keeps submitting
  // oldest-first batches (one in flight) until no unscored closed tickets remain.
  scoringBackfillPending    Boolean   @default(false)
  // Evaluation escalation: tickets the scoring model flags as beyond its reliable
  // evaluation are re-scored by a stronger model in a daily batch (~12x cost per
  // ticket — off by default; also inert while scoringEnabled is off). Model is
  // free-text but must be a real model id (the scoring path resolves no aliases).
  scoringEscalationEnabled            Boolean   @default(false)
  scoringEscalationModel              String    @default("claude-sonnet-4-6")
  scoringEscalationIntervalHours      Int       @default(24)
  scoringEscalationMaxTicketsPerBatch Int       @default(25)
  scoringEscalationLastRunAt          DateTime?
  // HashiCorp Vault connection (edited via /config → Vault; no .env on deploy).
  // vaultToken is encrypted at rest with the LOCAL crypto.ts key — it is the
  // bootstrap credential, Vault can't wrap its own token. vaultMigratedAt is the
  // storage cutover: null = secrets live in Postgres columns; set = the global
  // secrets live in Vault KV (columns hold the vault:kv sentinel) and user
  // tokens are Transit-encrypted.
  vaultEnabled        Boolean   @default(false)
  vaultAddr           String?
  vaultToken          String?
  vaultKvMount        String    @default("kv")
  vaultKvBasePath     String    @default("support-bot")
  vaultTransitMount   String    @default("transit")
  vaultTransitKey     String    @default("support-bot")
  vaultMigratedAt     DateTime?
  // Temporal worker pause switch: ON = the worker polls and owns all
  // background work; OFF = the worker is drained and background work pauses
  // (fire-and-forget signals keep landing server-side and process on resume;
  // there is no legacy scheduler fallback). Connection is edited via /config →
  // Temporal → Connection (deploy has no .env access; TEMPORAL_* env vars are
  // first-boot fallbacks only). The mTLS client cert lives in Vault KV
  // ("temporal" entry). temporalImportDoneAt = historical timestamp of the
  // one-time migration import (machinery removed after the cutover).
  temporalEnabled        Boolean   @default(false)
  temporalAddress        String?   // "host:port" of the mTLS frontend
  temporalNamespace      String?
  temporalTaskQueue      String    @default("support-bot")
  temporalDeploymentName String    @default("support-bot")
  // Transport security for the frontend connection. OFF = plaintext gRPC,
  // which is what a private-network deploy (Railway internal DNS, a service
  // mesh) wants: the frontend there listens without TLS, and dialing it with
  // TLS fails the handshake outright. ON = mTLS with the Vault-held client
  // cert. Certs stay stored either way; they are simply unused while off.
  temporalTlsEnabled     Boolean   @default(false)
  // TLS SNI / server-name override — needed when dialing by IP while the
  // server cert carries a hostname. Null = derive from the address. Ignored
  // while temporalTlsEnabled is off.
  temporalTlsServerName  String?
  temporalImportDoneAt DateTime?
  // Intercom teammates who count as billing admins for canvas/panel actions
  // (edited via /config → Billing → Intercom Admins). JSON array of
  // { id, name } — names snapshotted for display.
  intercomPanelAdminsJson Json?
  // Per-action access levels for the canvas/panel billing actions:
  // { "<actionKey>": "none" | "approval" | "all" }. Missing key = the
  // action's registry default. Edited via /config → Billing → Intercom Actions.
  billingActionLevelsJson Json?
  // Auto-generated HMAC key for Stripe-panel URL/API tokens (encrypted at
  // rest via crypto.ts; seeded on first use — never user-entered or shown).
  panelTokenSecret        String?
  // Stripe-panel token epoch: minted links/sessions embed it; bumping it
  // ("Revoke Stripe Panel Links" in /intercom → Maintenance) invalidates every
  // outstanding link and session instantly.
  panelTokenEpoch         Int     @default(0)
  // Admin web-panel (/config + /intercom) token epoch — a SEPARATE lever from
  // panelTokenEpoch so "Revoke Admin Panel Links" doesn't kill Stripe-panel
  // links (and vice versa). Admin tokens reuse panelTokenSecret as HMAC key.
  adminPanelEpoch         Int     @default(0)
  // Stripe dashboard (account-wide web surface at /dashboard). Default OFF —
  // routes answer 404 until an admin enables it from the Dashboard hub.
  dashboardEnabled        Boolean @default(false)
  // Who may open/enroll into the dashboard: JSON array of { id, name, role }
  // (Discord user ids are the authority, names snapshotted, role
  // "admin" | "operator" — default admin). Re-checked on EVERY request.
  dashboardAdminsJson     Json?
  // Dashboard token HMAC key — SEPARATE from panelTokenSecret: d1 tokens
  // include enroll links (credential-planting class), so the dashboard gets an
  // independent secret + rotation lever. Encrypted at rest via crypto.ts.
  dashboardTokenSecret    String?
  // Dashboard token/session epoch — bumping it ("Revoke dashboard links" /
  // LOCKDOWN) kills every outstanding dashboard link and session instantly,
  // independent of the other two panels.
  dashboardEpoch          Int     @default(0)
  // YubiKey OTP sign-in (Yubico validation protocol). Client ID from
  // upgrade.yubico.com/getapikey; blank disables the yubikey login path.
  yubicoClientId          String?
  // Yubico API secret (8th global secret: Vault KV sentinel / enc:v1 local).
  // Optional; without it verify responses are TLS-trusted but unsigned.
  yubicoApiSecret         String?
  // Optional self-hosted validation server (public https verify URL).
  // Blank = YubiCloud (https://api.yubico.com/wsapi/2.0/verify).
  yubicoValidationUrl     String?
  // SLA manager (edited via /intercom → SLA Manager). The bot IS the SLA
  // engine (Intercom Advanced has no native SLAs): rules pick a target, the
  // bot writes it to the slaAttributeName conversation attribute (inbox
  // visibility + Workflow/view branching), and the 5-min enforcement looper
  // runs the clocks and posts breach signals.
  slaEnabled       Boolean @default(false)
  slaNativeEnabled Boolean @default(false) // orphaned (kick-note rip 2026-07-17) — native conversations are covered whenever slaEnabled
  slaDefaultTarget String?                 // no-match target; null = clear a previously-written value
  slaAttributeName String  @default("SLA Target")
  slaNoteKickEnabled Boolean @default(true) // orphaned (kick-note rip 2026-07-17)
  slaNoteAdminId String?                    // orphaned (kick-note rip 2026-07-17)
  // Managed SLA target registry: JSON array of { value, note, firstReplyMins?,
  // nextReplyMins?, resolveMins?, warnPct? }. Rule targets and slaDefaultTarget
  // must reference an entry; durations are business-minutes for the bot-native
  // clocks (a clock left blank is disabled for that target).
  slaTargetsJson   Json?
  // Bot-native SLA engine (Expert-tier replacement). The enforcement looper
  // writes ok | at_risk | breached to this List conversation attribute
  // (created manually in Intercom — the API can't create conversation attrs).
  slaStatusAttributeName String  @default("SLA Status")
  slaBreachTagName       String  @default("sla-breached") // tagged on breach, untagged on recovery
  slaWarnPct             Int     @default(80)             // at_risk threshold, % of target (per-target override in slaTargetsJson)
  // Recurring agent nag: while a first-reply/next-reply clock is breached, the
  // enforcement sweep re-posts the breach note every slaNagRepeatMins of
  // BUSINESS time (office-hours aware). slaNagNoteText overrides the built-in
  // note copy ({clock}/{target}/{overdue}/{team} placeholders); null = default.
  slaNagRepeatMins       Int     @default(240)
  slaNagNoteText         String?
  // WORKSPACE-DEFAULT office hours + balanced assignment. Per-team overrides
  // (teamSettingsJson) layer on top per-field; a team with no override inherits
  // these. Office hours: SLA clocks count business time only while enabled —
  // JSON { tz, week: { mon..sun: [{ start, end }] }, holidays: ["YYYY-MM-DD"] }.
  officeHoursEnabled Boolean @default(false)
  officeHoursJson    Json?
  // Balanced assignment: the bot balances a conversation WITHIN its assigned
  // team's members (hybrid round-robin); excluded admins never receive bot
  // assignments. Edited via /intercom → Assignment.
  assignEnabled            Boolean @default(false)
  assignExcludedAdminsJson Json?   // [{ id, name }] — names snapshotted for display
  assignRotationCursorsJson Json?  // { [teamId]: adminId } — per-team round-robin cursor
  // Per-team overrides of the assignment + office-hours defaults above:
  // { [teamId]: { teamName?, assignEnabled?, assignExcludedAdmins?, officeHoursEnabled?, officeHoursJson? } }.
  // Any field absent = inherit the workspace default; a team with no entry
  // inherits everything. Edited via /intercom → Assignment and → SLA → Office Hours.
  teamSettingsJson         Json?
  updatedAt           DateTime  @updatedAt

  @@map("bot_settings")
}

// One row per AI run — both interactive Claude Code CLI runs and Batch API scoring
// runs (one aggregated row per batch). Feeds cost dashboards + the scoring budget cap.
model AiRun {
  id                  String   @id @default(cuid())
  agentName           String   // "support-<category>", "ai-ask", "ticket-scoring", …
  kind                String   // "customer_qa" | "staff_command" | "ticket_scoring"
  source              String   @default("cli") // "cli" | "api" | "batch"
  model               String
  outcome             String   // "success" | "error" | "api_limit" | "empty" | "batch_ended"
  sessionId           String?  // Claude Code session id (cli runs)
  batchId             String?  // Anthropic msgbatch_… id (batch runs)
  numTurns            Int?
  durationMs          Int?
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  costUsd             Float    @default(0)
  toolCalls           Int      @default(0)
  toolErrors          Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("ai_runs")
}

// Result text of a staff /ai run (ask|cause|draft|summarize), replayed as
// "Previous AI runs" context into later runs on the same ticket. Posted drafts
// are deleted (they land in the transcript); the rest is purged 3 days after
// the ticket closes (a reopen within that window keeps the history).
model TicketAiRun {
  id             String   @id @default(cuid())
  ticketThreadId String
  subcommand     String   // "ask" | "cause" | "draft" | "summarize"
  input          String?  // the ask question / draft instructions
  result         String
  invokerId      String
  invokerName    String
  model          String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, createdAt])
  @@map("ticket_ai_runs")
}

// AI quality evaluation of a closed ticket (one row per ticket — the unique
// ticketThreadId is the double-scoring guard). Reopened tickets get their row
// deleted so the next batch after re-close re-scores the fuller transcript.
model TicketScore {
  id               String    @id @default(cuid())
  ticketThreadId   String    @unique
  status           String    @default("PENDING") // PENDING | SCORED | FAILED | SKIPPED | ESCALATED (awaiting escalated re-score)
  attempts         Int       @default(0)
  batchId          String?   // Anthropic msgbatch_… holding/produced this score
  model            String?
  cxScore          Int?      // 1-10 predicted customer-experience score
  cxRationale      String?   // one-sentence model justification for cxScore
  sentimentStart   String?   // very_negative | negative | neutral | positive | very_positive
  sentimentEnd     String?
  agentTone        Int?      // 1-10, staff overall
  agentClarity     Int?
  agentCorrectness Int?
  resolution       String?   // resolved | unresolved | workaround
  fcr              Boolean?  // first-contact resolution
  escalationNeeded Boolean?
  topic            String?   // closed taxonomy (see scoringPrompt.ts)
  rootCause        String?
  summary          String?
  staffScores      Json?     // [{ name, tone, clarity, correctness }]
  staffNames       Json?     // string[]: STAFF display names seen in the transcript at submit time — the allowlist the model's staff[] output is reconciled against (null on rows from before this column existed)
  // Evaluation escalation: escalated=true from the moment the scoring model's
  // eval_escalation flag is honored, kept through the re-score as provenance
  // (a SCORED row with escalated=true was scored by the escalation model).
  escalated        Boolean   @default(false)
  escalationReason String?   // the flagging model's one-sentence eval_escalation_reason
  // Complexity snapshot taken at submit time (transcriptChars is pre-truncation) —
  // the objective veto that gates the model's escalation flag at result time.
  customerMessages Int?
  transcriptChars  Int?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float?
  error            String?
  scoredAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@map("ticket_scores")
}

// One row per submitted Anthropic Message Batch. Persisting the batch id is what
// makes polling restart-safe: the scheduler resumes any SUBMITTED batch on boot.
model ScoringBatch {
  id               String    @id @default(cuid())
  anthropicBatchId String    @unique
  status           String    @default("SUBMITTED") // SUBMITTED | ENDED | FAILED
  purpose          String    // "interval" | "backfill" | "escalation" | (manual smoke tests bypass batches)
  model            String
  requestCount     Int
  succeededCount   Int       @default(0)
  erroredCount     Int       @default(0)
  expiredCount     Int       @default(0)
  escalatedCount   Int       @default(0) // results whose eval_escalation flag was honored
  costUsd          Float?
  submittedAt      DateTime  @default(now())
  endedAt          DateTime?

  @@index([status])
  @@map("scoring_batches")
}

model StatusTag {
  id              String   @id @default(cuid())
  emoji           String   @unique
  label           String
  isInitial       Boolean  @default(false)
  closesThread    Boolean  @default(false)
  reminderEnabled Boolean  @default(false)
  reminderDays    Int      @default(3)
  reminderTarget  String   @default("SUPPORT")
  autoCloseAfter  Int?
  // Per-tag overrides for the reminder machinery ({days} placeholder = idle
  // day count). Null = built-in default text / reminderDays cadence.
  reminderTextCustomer String? // customer reminder embed text
  reminderTextSupport  String? // agent reminder Intercom-note text
  reminderRepeatDays   Int?    // cadence after the first reminder; null = reminderDays
  autoCloseMessage     String? // farewell posted when a ticket is AUTO-closed from this tag
  sortOrder       Int      @default(0)
  // When a customer replies to a Waiting-for-Customer ticket, it moves to the tag
  // flagged here (at most one) instead of reverting to its previous status. Unset
  // on every tag → fall back to the previous-status behaviour.
  isCustomerReplyTarget Boolean @default(false)
  // Intercom ticket state this tag maps to (set via /config → Intercom → States).
  intercomTicketStateId String?
  tickets         Ticket[]

  @@map("status_tags")
}

model Ticket {
  id                  String     @id @default(cuid())
  threadId            String     @unique
  channelId           String
  customerId          String?
  customerDisplayName String?
  categoryId          String?
  // Discord-only ticket: not mirrored to Intercom (no conversation, no
  // ticket, no events). Set at creation by the self-service refund flow.
  // The exemption lifts when the customer sends their first typed message
  // in the thread (a human needs to see it) — see flipRefundTicket.
  intercomExempt      Boolean    @default(false)
  // Stamped when the customer's first typed message flipped a refund ticket
  // from Discord-only to mirrored. Guards the boot backfill (ensureSchema)
  // from re-exempting the row, and marks the flip for the crash-heal retrigger.
  intercomExemptLiftedAt DateTime?
  statusTagId         String?
  statusTag           StatusTag? @relation(fields: [statusTagId], references: [id])
  // Status the ticket had before the last status change (plain id, no FK — resolved via
  // the SettingsStore cache). Used to restore a "Waiting for Customer" ticket when the
  // customer replies.
  prevStatusTagId     String?
  escalationTierId    String?
  escalationTier      EscalationTier? @relation(fields: [escalationTierId], references: [id])
  lastStatusChangeAt  DateTime   @default(now())
  lastReminderAt      DateTime?
  reminderCount       Int        @default(0)
  // Set by /reminders off: suppresses reminders, auto-close and re-close for this
  // ticket. Cleared automatically on every status change.
  remindersPaused     Boolean    @default(false)
  closed              Boolean    @default(false)
  closedAt            DateTime?
  // When set, the re-close scheduler locks/archives the thread again at this time.
  // Stamped (last message + 30m) whenever someone writes in an already-closed ticket.
  recloseAt           DateTime?
  question            String?
  // Resolved Postiz account for this ticket's customer, stamped best-effort at
  // creation from the platform's superadmin search. All null = never resolved
  // (lookup off, no match, or the call failed) — never treated as "no account".
  postizUserId        String?
  postizOrgId         String?
  postizTier          String? // STANDARD | TEAM | PRO | ULTIMATE, as the platform reports it
  postizRole          String? // USER | ADMIN | SUPERADMIN within postizOrgId
  postizLinkedAt      DateTime?
  // Verbatim final AI answer, persisted so a filed GitHub issue is just question +
  // answer (not a brittle re-scan of the last few thread messages).
  aiAnswer            String?
  firstResponseAt     DateTime?
  csatScore           Int?
  csatComment         String?
  csatPromptedAt      DateTime?
  csatRatedAt         DateTime?
  createdAt           DateTime   @default(now())

  @@map("tickets")
}

model TicketNote {
  id             String   @id @default(cuid())
  ticketThreadId String
  authorId       String
  authorName     String
  text           String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId])
  @@map("ticket_notes")
}

// Append-only status change history. Emoji+label are snapshotted as text
// so history survives tag edits and deletions.
model TicketTagChange {
  id             String   @id @default(cuid())
  ticketThreadId String
  kind           String   // "STATUS" (legacy rows may carry "PRIORITY" — inert history)
  fromEmoji      String?
  fromLabel      String?
  toEmoji        String
  toLabel        String
  actorId        String?
  actorName      String
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, kind])
  @@map("ticket_tag_changes")
}

// Ordered staff ladder (position 0 = lowest tier). Tier 0 gets new-ticket pings
// and its members are added to ticket threads; membership in any tier role counts
// as staff. Replaces the legacy single BotSettings.supportRoleId.
model EscalationTier {
  id        String   @id @default(cuid())
  name      String
  roleId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@map("escalation_tiers")
}

model CannedResponse {
  id        String   @id @default(cuid())
  name      String
  content   String
  // Discord user id when the response is personal; null means the whole team can use it.
  ownerId   String?
  createdAt DateTime @default(now())

  @@unique([name, ownerId])
  @@map("canned_responses")
}

// Discord ticket ↔ Intercom conversation + converted customer ticket. ticketId is
// null between conversation creation and a successful convert, which makes the
// ensure job crash-resumable.
model IntercomLink {
  id                String    @id @default(cuid())
  ticketThreadId    String    @unique
  contactId         String // Intercom contact id
  contactExternalId String // external_id we registered (postizUserId / discord:{id})
  conversationId    String    @unique
  ticketId          String?   @unique // Intercom ticket API id (NOT the human ticket_id)
  agentWarnedAt     DateTime? // push mode: one-time "replies don't reach the customer" note
  lastSyncedStateId String? // last ticket_state_id the bridge pushed (echo damper)
  lastSyncedOpen    String? // "open" | "closed" — conversation open/close parity damper
  // Last-seen Intercom tag name set (JSON string[]) — inbound tag-diff damper.
  lastTagsJson      Json?
  lastAssigneeId    String? // last Intercom admin assignee relayed to Discord (damper)
  createdAt         DateTime  @default(now())

  @@map("intercom_links")
}

// Part-id ledger for echo suppression (Intercom has no writable content stamp).
// The bridge records every conversation/ticket part it creates; the webhook
// handler atomically claims each part it sees — a conflict means it's either
// the bridge's own echo or a duplicate delivery, and gets dropped.
model IntercomEchoPart {
  id             String   @id @default(cuid())
  // "c" = conversation part, "t" = ticket part, "r" = relay body-hash dedup,
  // "m" = outbound delivery ledger (partId = discordMessageId — retry dedup),
  // "b" = backfill-enqueued marker (partId = threadId).
  kind           String
  partId         String
  ticketThreadId String
  // true = written by the outbound confirm (bridge-created part). A webhook
  // claim row is unconfirmed; releaseClaim only deletes unconfirmed rows so a
  // racing confirm's record can never be erased by a deferring webhook.
  confirmed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([kind, partId])
  @@index([createdAt])
  @@map("intercom_echo_parts")
}

// Discord message ↔ Intercom conversation part mapping, both directions —
// powers true delete/edit reflection (redact API outbound, the
// conversation_part.redacted webhook inbound). Rows carry indefinite-lifetime
// semantics like the "m" delivery ledger: a message can be deleted years later.
model IntercomMessageMap {
  id               String    @id @default(cuid())
  ticketThreadId   String
  // "out"  = Discord message mirrored into Intercom (partId = the created part)
  // "in"   = Intercom agent reply relayed into Discord (discordMessageId = relayed message)
  // "note" = Intercom internal note mirrored to a staff note (discordMessageId = TicketNote id)
  direction        String
  discordMessageId String
  partId           String    @unique
  via              String? // "in" rows: how the relay was sent — "webhook" | "bot"
  redactedAt       DateTime? // either side already deleted — echo damper for the redact webhook
  createdAt        DateTime  @default(now())

  @@unique([direction, discordMessageId])
  @@index([ticketThreadId])
  @@map("intercom_message_maps")
}

// Inactivity-sweeper damper state for NATIVE (unbridged) Intercom
// conversations/tickets — bridged tickets keep their reminder counters on the
// tickets row. One row per swept object; the nag counter resets when the
// customer replies between sweeps.
model IntercomSweepState {
  id                  String    @id // conversation id, or "ticket:<id>" for native tickets
  kind                String // "conversation" | "ticket"
  lastAgentRemindedAt DateTime?
  customerNagCount    Int       @default(0)
  lastCustomerNagAt   DateTime?
  sweepClosedAt       DateTime? // set when the sweeper auto-closed it (skip until it reopens)
  updatedAt           DateTime  @updatedAt

  @@map("intercom_sweep_state")
}

// Dedup ledger for incoming Stripe webhook events (Stripe redelivers on non-2xx
// and occasionally at-least-once). The event id is globally unique, so it is the
// primary key — an insert conflict means "already handled → drop".
model StripeWebhookEvent {
  id        String   @id // Stripe event id (evt_…)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("stripe_webhook_events")
}

// Reserve→call→confirm echo records: the outbox writes a row (normalized body
// hash) BEFORE posting to Intercom and deletes it after recording the created
// part id in the echo ledger. The webhook handler treats a matching row as
// "this part is our own in-flight post" — replaces the old fixed-sleep race.
model IntercomPendingPost {
  id             String   @id @default(cuid())
  ticketThreadId String
  kind           String // "c" | "t"
  bodyHash       String // sha256 of whitespace-collapsed plain text of the sent body
  createdAt      DateTime @default(now())

  @@index([ticketThreadId, bodyHash])
  @@map("intercom_pending_posts")
}

// Local mirror of Stripe disputes, fed by webhooks and reconciled by the
// disputes looper. Stripe's disputes.list has no status filter, so the
// open-disputes overview reads from here; evidenceDraft holds the staff/AI
// draft text before it is staged at Stripe (survives Discord session expiry).
model StripeDispute {
  id                  String    @id // Stripe dispute id (dp_… / du_…)
  chargeId            String
  paymentIntentId     String?
  customerId          String? // Stripe cus_… (null for guest charges / deleted customers)
  amount              Int
  currency            String
  reason              String
  status              String // needs_response | under_review | warning_* | won | lost | prevented
  evidenceDueBy       DateTime?
  evidenceDraft       Json? // local staff/AI evidence draft ({ field: text })
  evidenceFinal       Json? // text evidence as last seen at Stripe once submitted ({ field: text }) — won-dispute exemplars for AI drafting
  evidenceSubmittedAt DateTime?
  lastReminderAt      DateTime? // evidence-due reminder damper (≤1 ping / 24h / dispute)
  lastUrgentReminderAt DateTime? // urgent-tier damper (≤1 urgent ping / 24h / dispute)
  disputeCreatedAt    DateTime
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([evidenceDueBy])
  @@index([chargeId])
  @@index([customerId])
  @@index([closedAt])
  @@map("stripe_disputes")
}

// Billing blocklist: one row per blocked identifier, mirrored into a Stripe
// Radar value list (radarItemId) so future payments are blocked at Stripe,
// while the bot denies self-service billing and flags staff panels. Unblock
// hard-deletes the row — action history lives in the audit channel + Influx.
model BlockedEntity {
  id          String   @id @default(cuid())
  kind        String // card_fingerprint | email | customer_id | ip_address
  value       String // emails are stored lowercased
  reason      String
  source      String   @default("manual") // manual | auto_dispute
  actorId     String? // Discord admin id (null = automatic)
  actorName   String?
  customerId  String? // related cus_… for BLOCKED-banner lookups
  disputeId   String?
  radarItemId String? // rli_… — needed to remove the Radar item on unblock
  createdAt   DateTime @default(now())

  @@unique([kind, value])
  @@index([customerId])
  @@map("blocked_entities")
}

// Team-visible staff notes on billing objects (dispute/customer/charge) — the
// billing-panel counterpart of ticket_notes.
model BillingNote {
  id         String   @id @default(cuid())
  objectType String // dispute | customer | charge
  objectId   String
  authorId   String
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([objectType, objectId])
  @@map("billing_notes")
}

// Shared team bookmark board for billing objects (one row per object — a
// pinned watchlist every admin sees and edits, not per-user lists).
model BillingBookmark {
  id          String   @id @default(cuid())
  objectType  String // dispute | customer | charge
  objectId    String
  label       String? // display label snapshotted at bookmark time
  addedById   String
  addedByName String
  createdAt   DateTime @default(now())

  @@unique([objectType, objectId])
  @@map("billing_bookmarks")
}

// Per-admin dispute watch subscriptions — watchers get a DM when the dispute's
// status changes or funds move.
model DisputeWatch {
  id        String   @id @default(cuid())
  disputeId String
  userId    String // Discord user id
  createdAt DateTime @default(now())

  @@unique([disputeId, userId])
  @@map("dispute_watches")
}

// Ordered SLA rules (position = priority, 0 = highest; first enabled match
// wins; conditions are AND-ed). `conditions` is the structured form
// (SlaCondition[], zod-validated); `expression` is the canonical text form,
// regenerated on every save — the two round-trip. `target` is the value the
// bot writes to the SLA Target conversation attribute (must exist in
// BotSettings.slaTargetsJson). Edited via /intercom → SLA Manager.
model SlaRule {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  conditions Json
  expression String
  target     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sla_rules")
}

// Per-subject SLA state: write-dedup damper + manual pin. One row per subject,
// id = "t:<threadId>" (bridged ticket) or "c:<conversationId>" (native
// conversation) — pins live here rather than on Ticket so native conversations
// get the same treatment. lastWrittenTarget is the last value actually PUT to
// Intercom (writes are skipped while the computed target matches it).
model SlaState {
  id                String    @id
  kind              String // "bridged" | "native"
  conversationId    String? // resolved Intercom conversation (bridged: from the link)
  lastTarget        String? // last computed winning target
  lastWrittenTarget String?
  lastRuleId        String?
  lastEvaluatedAt   DateTime?
  lastWriteError    String? // last permanent write failure — surfaced in the SLA hub
  lastKickPartId    String? // orphaned (kick-note rip 2026-07-17)
  pinnedTarget      String? // non-null = rules skipped for this subject
  pinnedById        String?
  pinnedByName      String?
  pinnedAt          DateTime?
  // Enforcement clock markers (bot-native SLA engine). Warned/breached stamps
  // dedup alerts (one warn + one breach per clock per cycle); nrCycleAnchor
  // identifies the current customer-waiting cycle (a new waiting_since resets
  // the next-reply markers); frHumanReplyAt caches the parts-verified first
  // REAL human admin reply for native conversations.
  frHumanReplyAt    DateTime?
  frVerifyNoneAt    DateTime? // last parts-verify that found NO human reply (re-check only after a newer admin reply)
  frWarnedAt        DateTime?
  frBreachedAt      DateTime?
  frLastNaggedAt    DateTime? // last recurring agent nag posted for a breached first-reply clock (paces the re-nag)
  nrCycleAnchor     DateTime?
  nrWarnedAt        DateTime?
  nrBreachedAt      DateTime?
  nrLastNaggedAt    DateTime? // last recurring agent nag posted for a breached next-reply clock (reset with the cycle)
  resWarnedAt       DateTime?
  resBreachedAt     DateTime?
  lastStatusWritten String? // last SLA Status attribute value actually PUT (write damper)
  breachTagged      Boolean   @default(false) // breach tag currently on the conversation
  lastEnforcedAt    DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@map("sla_states")
}

// ---- Stripe dashboard standing auth ----

// Per-admin dashboard credentials: any number of passkey/totp/yubikey rows
// plus one passphrase row (upserted). Passkey public keys and scrypt hashes
// are NOT secrets (rotation-immune); the TOTP secret is encrypted (Vault
// Transit envelope when active, local enc:v1 otherwise). YubiKey OTP rows
// store only the key's public ID (in credentialId); verification is remote.
model DashboardCredential {
  id                 String    @id @default(cuid())
  discordUserId      String
  kind               String // "passkey" | "totp" | "passphrase" | "yubikey"
  label              String?
  // passkey rows (credentialId also carries the yubikey public ID)
  credentialId       String?   @unique // base64url (yubikey: modhex public ID)
  publicKey          String? // base64url-encoded COSE public key
  signCount          Int?
  transports         String? // comma-joined transport hints
  backupState        Boolean?
  // trusted passkeys sign in directly (no passphrase, no Discord activation);
  // set at enrollment only, behind a fresh step-up. yubikey rows are
  // implicitly trusted and ignore this flag.
  trusted            Boolean   @default(false)
  // totp rows
  secretEnc          String?
  lastUsedStep       Int? // accepted-code replay guard
  // passphrase rows
  hash               String? // self-describing scrypt string
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
  revokedAt          DateTime?

  @@index([discordUserId, kind])
  @@map("dashboard_credentials")
}

// DB-backed standing sessions (survive deploys). id = SHA-256 hex of the
// cookie token — a DB dump yields no usable session. 7d idle / 30d absolute.
model DashboardSession {
  id                 String    @id
  discordUserId      String
  adminName          String
  epoch              Int
  state              String // "locked" | "active"
  authMethod         String // "passkey" | "totp" | "breakglass"
  credentialIdUsed   String?
  activationCode     String? // present while locked (useless without the cookie)
  activationAttempts Int       @default(0)
  uaFirst            String?
  ipFirst            String?
  ipLast             String?
  stepUpAt           DateTime? // last fresh-factor re-assert (T2 window)
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  absoluteExpiresAt  DateTime
  revokedAt          DateTime?

  @@index([discordUserId])
  @@index([absoluteExpiresAt])
  @@map("dashboard_sessions")
}

// Append-only dashboard audit trail (auth lifecycle + actions) — doubles as
// the Security page's recent-activity feed and a forensic record independent
// of Discord channel retention.
model DashboardAuditLog {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  actorId       String
  actorName     String
  kind          String // "auth" | "action" | "admin"
  action        String
  targetId      String?
  summary       String
  outcome       String // "ok" | "denied" | "failed"
  ip            String?
  sessionIdHash String?

  @@index([at])
  @@index([actorId, at])
  @@map("dashboard_audit_log")
}

// Sentry User Feedback → Intercom import ledger: one row per TERMINAL outcome
// ("imported" | "skipped_no_email"). Dedup key = Sentry issue id (widget
// feedback is 1:1 issue↔submission); the conversation id powers the
// inactivity-sweeper/SLA exemption lookups. Failed items get NO row — the
// sync watermark freezes at them and the next tick retries.
model SentryFeedbackImport {
  id                     String   @id @default(cuid())
  sentryIssueId          String   @unique
  sentryShortId          String?
  projectSlug            String?
  status                 String // "imported" | "skipped_no_email"
  contactEmail           String?
  contactName            String?
  intercomContactId      String?
  intercomConversationId String?  @unique // Postgres unique ignores NULLs, so skipped rows coexist
  intercomTicketId       String? // set when the conversation was converted to a customer ticket
  pageUrl                String?
  // Acting identity carried on the Sentry event (tags, or the user context on
  // older platform builds). Captured even for skipped rows: it is what lets a
  // previously anonymous submission be replayed once the reader understands
  // the newer event shape.
  postizUserId           String?
  postizOrgId            String?
  stripeCustomerId       String?
  // Stamped when a skipped row has been re-examined. Retry is one-shot: a row
  // that still resolves to nothing stays skipped rather than being re-read on
  // every tick forever.
  retriedAt              DateTime?
  feedbackAt             DateTime // Sentry issue firstSeen — watermark math + audit
  importedAt             DateTime @default(now())

  @@index([importedAt])
  @@map("sentry_feedback_imports")
}

// Organization to Stripe customer mapping, harvested from Sentry events.
//
// The platform creates its Stripe customer with an email and name and NO
// metadata, so nothing on the Stripe object points back at the organization,
// and the platform's own search endpoint does not expose paymentId. A backend
// Sentry event is the one place both ids appear together, so every event the
// bot reads that carries the pair is recorded here. Ids only: no email, no
// name, nothing that is not already in both systems.
model PostizOrgLink {
  id               String   @id @default(cuid())
  orgId            String   @unique
  stripeCustomerId String
  // Bumped on every re-observation, so a stale mapping is visible as one that
  // stopped being seen rather than silently trusted forever.
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  observations     Int      @default(1)

  @@index([stripeCustomerId])
  @@map("postiz_org_links")
}

// Forwarded-email conversion ledger: one row per converted conversation.
// originalConversationId = the misattributed teammate-authored conversation
// (unique = idempotency across webhook retries); newConversationId = the
// recreated customer-authored one (unique = self-trigger belt + canvas reverse
// lookup). Also powers the SLA exemption when Intercom reopens the closed
// original on a repeat forward into the same thread.
model ForwardedEmailConvert {
  id                     String   @id @default(cuid())
  originalConversationId String   @unique
  newConversationId      String?  @unique
  forwarderAdminId       String?
  forwarderEmail         String?
  customerEmail          String
  customerName           String?
  intercomContactId      String?
  contactRole            String? // "user" | "lead" — decides the attachment re-upload author
  trigger                String // "auto" | "manual"
  actorLabel             String? // manual trigger: the acting teammate
  attachmentsCount       Int      @default(0)
  attachmentsReuploaded  Boolean  @default(false)
  convertedAt            DateTime @default(now())

  @@index([convertedAt])
  @@map("forwarded_email_converts")
}
