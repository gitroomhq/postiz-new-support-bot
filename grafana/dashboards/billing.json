    {
      "id": 4,
      "type": "stat",
      "title": "Pending charge reviews (now)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
