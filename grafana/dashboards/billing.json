          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"billing_events\")\n  |> filter(fn: (r) => r._field == \"count\" and (r.event == \"charge_review_created\" or r.event == \"charge_review_approved\" or r.event == \"charge_review_denied\"))\n  |> keep(columns: [\"_time\", \"_value\", \"event\"])\n  |> group(columns: [\"event\"])\n  |> aggregateWindow(every: 7d, fn: sum, createEmpty: true)\n  |> fill(value: 0.0)",
