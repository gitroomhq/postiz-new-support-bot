      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -2h)\n  |> filter(fn: (r) => r._measurement == \"ticket_snapshot_totals\" and r._field == \"pending_charge_reviews\")\n  |> last()",
          "refId": "A"
