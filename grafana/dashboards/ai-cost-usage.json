    {
      "id": 10,
      "type": "timeseries",
      "title": "Scoring spend per day (vs daily cap)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_runs\")\n  |> filter(fn: (r) => r._field == \"cost_usd\" and r.kind == \"ticket_scoring\")\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true)\n  |> fill(value: 0.0)\n  |> set(key: \"_field\", value: \"scoring cost\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
          "refId": "A"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "import \"array\"\narray.from(rows: [{_time: v.timeRangeStart, _value: float(v: ${daily_scoring_budget_usd})}, {_time: v.timeRangeStop, _value: float(v: ${daily_scoring_budget_usd})}])\n  |> set(key: \"_field\", value: \"daily cap\")"
        }
