      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_scores\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> keep(columns: [\"_value\", \"fcr\"])\n  |> group(columns: [\"fcr\"])\n  |> sum()\n  |> pivot(rowKey: [], columnKey: [\"fcr\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ _value: (if exists r.true then r.true else 0.0) / ((if exists r.true then r.true else 0.0) + (if exists r.false then r.false else 0.0) + 0.0001) }))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
