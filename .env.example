# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_THREADS_CHANNEL_ID=your_threads_channel_id
DISCORD_SUPPORT_ROLE_ID=your_support_role_id

# Postiz OAuth
POSTIZ_FRONTEND_URL=https://app.postiz.com
POSTIZ_API_URL=https://app.postiz.com/api
POSTIZ_CLIENT_ID=pca_your_client_id
POSTIZ_CLIENT_SECRET=pcs_your_client_secret
POSTIZ_CALLBACK_URL=http://localhost:3000/callback

# Server
SERVER_PORT=3000

# GitHub (for feature request issues)
GH_BOT_TOKEN=ghp_your_github_token
GH_BOT_REPO=owner/repo

# Stripe
STRIPE_SECRET_KEY=sk_your_stripe_secret_key
STRIPE_DISCOUNT_COUPON_ID=your_50_percent_off_coupon_id

# Claude Code (used by --bare mode for AI support responses)
ANTHROPIC_API_KEY=sk-ant-your_api_key

# Intercom bridge (optional — each of these can also be set live via /config → Intercom,
# and the /config value takes precedence over the env value)
INTERCOM_ACCESS_TOKEN=your_intercom_access_token
INTERCOM_CLIENT_SECRET=your_intercom_app_client_secret
INTERCOM_ADMIN_ID=your_intercom_admin_id
INTERCOM_REGION=us
INTERCOM_TEAM_ID=your_intercom_team_id

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/postiz_support_bot

# Temporal (self-hosted, mTLS) — OPTIONAL first-boot fallbacks only. The real
# connection values are edited live via /config → Temporal → Connection and
# stored in BotSettings (the deploy has no .env access); these env vars are
# read only when the /config values are empty, like the INTERCOM_* fallbacks.
# The mTLS client cert/key/CA are entered via /config → Temporal →
# Certificates (stored in Vault KV under "<kvBasePath>/temporal").
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=
TEMPORAL_DEPLOYMENT_NAME=
# TLS SNI / server-name override — set when dialing by IP while the server
# cert carries a hostname (also editable via /config → Temporal → Connection).
TEMPORAL_TLS_SERVER_NAME=
# Worker build id fallback when the deploy has no .git directory (normally the
# 6-char SHA comes from `git rev-parse --short=6 HEAD` at boot).
GIT_SHA=
