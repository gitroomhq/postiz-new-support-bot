# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_THREADS_CHANNEL_ID=your_threads_channel_id
DISCORD_SUPPORT_ROLE_ID=your_support_role_id

# Postiz OAuth
POSTIZ_FRONTEND_URL=https://app.postiz.com
POSTIZ_API_URL=https://app.postiz.com/api
POSTIZ_CLIENT_ID=pca_your_client_id
POSTIZ_CLIENT_SECRET=pcs_your_client_secret
POSTIZ_CALLBACK_URL=http://localhost:3000/callback

# Server
SERVER_PORT=3000

# GitHub (for feature request issues)
GH_BOT_TOKEN=ghp_your_github_token
GH_BOT_REPO=owner/repo

# Stripe
STRIPE_SECRET_KEY=sk_your_stripe_secret_key
STRIPE_DISCOUNT_COUPON_ID=your_50_percent_off_coupon_id

# Claude Code (used by --bare mode for AI support responses)
ANTHROPIC_API_KEY=sk-ant-your_api_key

# Intercom bridge (optional — each of these can also be set live via /config → Intercom,
# and the /config value takes precedence over the env value)
INTERCOM_ACCESS_TOKEN=your_intercom_access_token
INTERCOM_CLIENT_SECRET=your_intercom_app_client_secret
INTERCOM_ADMIN_ID=your_intercom_admin_id
INTERCOM_REGION=us
INTERCOM_TEAM_ID=your_intercom_team_id

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/postiz_support_bot

# ---------------------------------------------------------------------------
# Infrastructure (Vault + Temporal): the only settings where a set env var
# OVERRIDES the value stored via /config. Everything else in this file either
# seeds the database once or loses to /config. The reason is bootstrapping:
# Vault holds the Temporal mTLS certs, Temporal runs the background work, and
# /config itself is only reachable once the bot is up. Leave these blank to
# manage everything from Discord; set one to pin it from the deploy. The panels
# label every pinned field, and edits made there are still stored and take
# effect the moment the variable is removed.
# ---------------------------------------------------------------------------

# HashiCorp Vault (secret storage) — /config → Vault
# VAULT_ENABLED accepts 1/true/yes/on and 0/false/no/off.
VAULT_ENABLED=
VAULT_ADDR=
# Orphan token carrying the support-bot policy, no TTL (unattended use).
VAULT_TOKEN=
VAULT_KV_MOUNT=
VAULT_KV_BASE_PATH=
VAULT_TRANSIT_MOUNT=
VAULT_TRANSIT_KEY=

# Temporal (self-hosted, mTLS) — /config → Temporal → Connection
# TEMPORAL_ENABLED is the worker pause switch (same boolean spellings as above);
# pin it on so a fresh deploy comes up already polling.
TEMPORAL_ENABLED=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=
TEMPORAL_DEPLOYMENT_NAME=
# TLS SNI / server-name override — set when dialing by IP while the server
# cert carries a hostname.
TEMPORAL_TLS_SERVER_NAME=

# Temporal mTLS material. THE ONE EXCEPTION to the override rule above: Vault KV
# ("<kvBasePath>/temporal", written by /config → Temporal → Certificates) stays
# authoritative, and these PEM file paths are read only when KV holds no
# temporal entry — so a deploy that already keeps its certs in Vault never
# silently falls back to stale files. Cert and key are required together; the
# CA is optional. Files are re-read when their size/mtime changes.
TEMPORAL_TLS_CERT_FILE=
TEMPORAL_TLS_KEY_FILE=
TEMPORAL_TLS_CA_FILE=

# Worker build id fallback when the deploy has no .git directory (normally the
# 6-char SHA comes from `git rev-parse --short=6 HEAD` at boot).
GIT_SHA=
